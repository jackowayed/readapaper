{
  "name": "readapaper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@serwist/next": "9.5.12",
    "isomorphic-dompurify": "^2.16.0",
    "jsdom": "^26.1.0",
    "nanoid": "^5.1.5",
    "next": "^15.1.0",
    "nodemailer": "10.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.6",
    "serwist": "9.5.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
